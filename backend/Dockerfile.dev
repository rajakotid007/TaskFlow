# Development image for the Rails API and the Sidekiq worker.
# Source code is bind-mounted; gems live in a named volume.
FROM ruby:3.3-slim

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends build-essential git libpq-dev libyaml-dev postgresql-client curl \
 && rm -rf /var/lib/apt/lists/*

ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_JOBS=4 \
    RAILS_LOG_TO_STDOUT=1

WORKDIR /app

RUN gem install rails -v "~> 8.0.0" --no-document

EXPOSE 3000
CMD ["bash", "-c", "bundle install && bin/rails db:prepare && bin/rails server -b 0.0.0.0 -p 3000"]
