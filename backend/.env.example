# Copy to .env (never commit real values). Defaults match docker-compose.yml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://taskflow:taskflow@localhost:5432/taskflow_development
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173
# Development-only simulation controls. Forced routing outcomes are refused unless true.
ALLOW_SIMULATION_CONTROLS=true
