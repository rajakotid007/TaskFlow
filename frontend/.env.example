# All optional. Defaults work with `docker compose up` + `npm run dev`.
# PORT=5174
# VITE_API_PROXY_TARGET=http://localhost:3000   # where the dev server proxies /api and /cable
# VITE_API_BASE_URL=/api/v1                     # API base used by the browser
# VITE_CABLE_URL=ws://localhost:5174/cable      # Action Cable endpoint
# PW_CHANNEL=msedge                             # Playwright browser channel (or chromium)
